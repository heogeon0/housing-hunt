# 개인정보는 레포에 커밋하지 않는다. 실제 값은 클라우드 routine 설정에만 둔다.
HH_INCOME_MONTHLY=            # 건강보험 보수월액 (원). 실수령이 아니다.
HH_ASSETS_SELF=               # 본인 총자산 (원) = 부동산 공시가 + 금융자산 - 부채
HH_ASSETS_PARENTS=            # 본인+부모 합산 총자산 (2순위 판정용, 선택)
HH_INCOME_PARENTS=            # 본인+부모 합산 월소득 (2순위 판정용, 선택)
HH_MAX_COMMUTE_MIN=60         # 이 시간 넘으면 브리핑에서 뺀다
